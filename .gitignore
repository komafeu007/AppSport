# Dependencies
node_modules/

# Expo / builds
.expo/
.expo-shared/
dist/
web-build/
build/
expo-env.d.ts

# Native généré (Continuous Native Generation) — ne pas commiter
/ios
/android
.kotlin/
*.orig.*

# Env & secrets — NE JAMAIS commiter
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision

# Metro
.metro-health-check*

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Base de données locale : elle vit sur l'appareil, jamais dans le dépôt
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Éditeurs / OS
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

